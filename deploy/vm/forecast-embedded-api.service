[Unit]
Description=Demand forecast embedded API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=forecast
Group=forecast
WorkingDirectory=/opt/demand-forecasting-model/apps/forecast_embedded
EnvironmentFile=/opt/demand-forecasting-model/.env
ExecStart=/opt/demand-forecasting-model/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 3000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
