# Development ClickHouse connection.
# Use a separate ClickHouse database/schema from production.
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=
CLICKHOUSE_SECURE=true
CLICKHOUSE_VERIFY=false
FORECAST_TABLE_SUFFIX=_dev

# Embedded API/UI dev defaults.
APP_ENV=dev
APP_TITLE=Bakery Forecast Embedded DEV
PORT=3001
BITRIX_EMBED_MODE=false
ACCESS_CONTROL_ENABLED=false
ACTIVE_RUN_ID=

# Development inference defaults.
# Keep activation disabled by default; activate only inside the suffixed dev tables.
FORECAST_SCENARIO=uplifted_norm
FORECAST_HORIZON_DAYS=14
FORECAST_UPLIFT_PROFILE_VERSION=sku_uplift_20260601
FORECAST_ACTIVATE_RUN=none
FORECAST_RUN_PREFIX=dev
FORECAST_RECENT_CORRECTION_MODE=runner_city_prior_soft_weekpart
FORECAST_RECENT_CORRECTION_DAYS=30
FORECAST_RECENT_SALES_TABLE=mart_sales_60d

# Dev runs should start from existing local datasets unless explicitly enabled.
FORECAST_REFRESH_DATASETS=false
